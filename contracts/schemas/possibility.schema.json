{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psi-seed.local/schemas/possibility.schema.json",
  "title": "\u03a8-SEED Possibility",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "possibility_id",
    "created_at",
    "source",
    "description",
    "candidate_type",
    "status",
    "relevance",
    "risk",
    "uncertainty",
    "provenance",
    "causation_chain_id"
  ],
  "properties": {
    "possibility_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "candidate_type": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "DEFERRED",
        "REJECTED",
        "SUPPRESSED",
        "ABANDONED",
        "SELECTED",
        "EXPIRED",
        "RESOLVED"
      ]
    },
    "relevance": {
      "type": "number",
      "minimum": 0
    },
    "risk": {
      "type": "number",
      "minimum": 0
    },
    "uncertainty": {
      "type": "number",
      "minimum": 0
    },
    "provenance": {
      "type": "object"
    },
    "causation_chain_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
