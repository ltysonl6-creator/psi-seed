{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "psi-seed://contracts/schemas/semantic-integrity-report.schema.json",
  "title": "Ψ-SEED Semantic Integrity Report",
  "type": "object",
  "required": ["contract_version", "valid", "issue_count", "issues", "rollback_transition_ids"],
  "properties": {
    "contract_version": {"const": "0.11"},
    "valid": {"type": "boolean"},
    "issue_count": {"type": "integer", "minimum": 0},
    "rollback_transition_ids": {"type": "array", "items": {"type": "string"}},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "issue"],
        "properties": {
          "code": {"type": "string", "pattern": "^SI-[0-9]{3}$"},
          "issue": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
